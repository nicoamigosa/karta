{
  "version": "karta-v1",
  "mode": "light-only",
  "color": {
    "paper": "#F3EBDD",
    "card": "#FFFAF0",
    "line": "#E4D5BD",
    "ink": "#4E1A12",
    "inkMuted": "#7A4A3C",
    "brand": "#A5432D",
    "cardEdge": ["#EADDC7", "#E3D3B9", "#DCCAAD", "#D5C1A2"],
    "buttonEdge": "#E0CFB3",
    "shadow": "rgba(80,50,25,0.45)"
  },
  "suit": {
    "breakfast": { "back": "#E3A33B", "edge": "#B5761C", "chip": "#F6DFAE", "chipInk": "#6B4A10" },
    "lunch":     { "back": "#7C9A6D", "edge": "#58724A", "chip": "#DCE6D2", "chipInk": "#3F5A34" },
    "dinner":    { "back": "#C8553D", "edge": "#9E3E2B", "chip": "#F4CDBF", "chipInk": "#7E2F1F" },
    "dessert":   { "back": "#C2677A", "edge": "#9C4459", "chip": "#F4D3D9", "chipInk": "#7A2E40" }
  },
  "font": {
    "display": { "family": "Fraunces", "axes": { "SOFT": 100 }, "license": "OFL" },
    "ui": { "family": "Figtree", "license": "OFL" }
  },
  "type": {
    "wordmark":  { "font": "display", "weight": 900, "size": 30, "tracking": -0.8, "color": "brand" },
    "rank":      { "font": "display", "weight": 900, "size": 40, "lineHeight": 0.85, "color": "ink" },
    "rankUnit":  { "font": "ui", "weight": 800, "size": 11, "tracking": 1.2, "case": "upper", "color": "ink" },
    "suitLabel": { "font": "display", "weight": 600, "italic": true, "size": 20, "case": "lower", "color": "ink" },
    "cardTitle": { "font": "display", "weight": 700, "size": 33, "lineHeight": 1.0, "tracking": -0.6, "color": "ink" },
    "chip":      { "font": "ui", "weight": 700, "size": 14 },
    "button":    { "font": "ui", "weight": 700, "size": 14, "color": "ink" }
  },
  "radius": { "card": 26, "cardBackFrame": 18, "photo": 18, "chip": 12, "pill": 999, "appIcon": "system" },
  "space": {
    "screenX": 22,
    "headerToDeck": 22,
    "cardPadding": { "top": 12, "x": 12, "bottom": 18 },
    "cardGap": 12,
    "cardTextInset": 8,
    "chipGap": 8,
    "chipPadding": { "y": 7, "x": 12 },
    "backFrameInset": 9
  },
  "elevation": {
    "cardFront": { "edgeLayers": "color.cardEdge (1px each, 4 layers, y+1..y+4)", "drop": { "y": 22, "blur": 34, "spread": -10, "color": "color.shadow" } },
    "cardBack":  { "edgeLayers": "suit.<course>.edge (4 layers)", "drop": { "y": 14, "blur": 22, "spread": -8, "color": "rgba(80,50,25,0.35)" } },
    "button":    { "edge": { "y": 2, "color": "color.buttonEdge" }, "drop": { "y": 6, "blur": 12, "spread": -4, "color": "rgba(80,50,25,0.25)" } },
    "chip":      { "innerTop": "rgba(255,255,255,0.6) 1px", "innerBottom": "rgba(78,26,18,0.10) 2px", "drop": "0 1px 2px rgba(80,50,25,0.15)" }
  },
  "deck": {
    "front":   { "inset": { "left": 0, "right": 0, "top": 0, "bottom": 18 }, "rotate": 0 },
    "back1":   { "inset": { "left": 4, "right": 16, "top": 12, "bottom": 10 }, "rotate": -4 },
    "back2":   { "inset": { "left": 16, "right": 4, "top": 20, "bottom": 4 }, "rotate": 6 },
    "leaving": { "translateY": "-115%", "rotate": -9, "opacity": 0 },
    "motion":  { "durationMs": 460, "curve": [0.22, 1, 0.36, 1], "faceRevealMs": 300, "faceRevealDelayMs": 120 },
    "swipeThresholdPt": 40
  }
}
